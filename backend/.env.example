# PhishShield AI Backend Configuration
# Copy this file to .env and adjust values for your environment

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS origins (comma-separated) — include your dashboard dev server origin
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,chrome-extension://*

# ML model path (relative to backend/ directory)
MODEL_PATH=models/phishshield_model.joblib

# Request limits
MAX_URL_LENGTH=2048
REQUEST_TIMEOUT_SECONDS=30

# API version
API_VERSION=v1
