{
  "manifest_version": 3,
  "name": "PhishShield AI",
  "version": "1.0.0",
  "description": "Your personal phishing guard. Analyse suspicious URLs before you visit them.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://phishshield-ai-uvv5.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://phish-shield-ai-pink.vercel.app/*",
      "http://localhost:5173/*",
      "http://localhost:5174/*",
      "http://127.0.0.1:5173/*",
      "http://127.0.0.1:5174/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
